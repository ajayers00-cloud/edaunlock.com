{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "eda-unlock-support",
  "main": "./worker/index.ts",
  "compatibility_date": "2026-09-22",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "assets": {
    "directory": "./dist/client",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "observability": {
    "enabled": true
  },
  "routes": [
    {
      "pattern": "edaunlock.com",
      "custom_domain": true
    },
    {
      "pattern": "www.edaunlock.com",
      "custom_domain": true
    }
  ]
}
